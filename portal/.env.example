# Base PostgreSQL (ressource PostgreSQL créée dans Coolify)
DATABASE_URL="postgresql://facescan:MOT_DE_PASSE@HOTE:5432/facescan"

# Authentification — secret : openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Adresse publique du portail (sans / final)
BETTER_AUTH_URL="https://facescan.altioresante.cloud"
# true le temps de créer les comptes de l'équipe, puis false
ALLOW_SIGNUP="true"

# Stockage des fichiers 3D (volume persistant)
STORAGE_DIR="/data/scans"
# Chiffrement AES-256-GCM des fichiers : openssl rand -base64 32 — À CONSERVER (sans elle, fichiers illisibles)
STORAGE_ENCRYPTION_KEY=""

# Optionnel : webhook n8n appelé à chaque nouveau scan
N8N_WEBHOOK_URL=""
